# Copie este arquivo para .env e coloque sua chave real localmente.
# NUNCA envie o arquivo .env ao GitHub.
GEMINI_API_KEY=cole_sua_chave_aqui
GEMINI_MODEL=gemini-3.8-flash
DATABASE_PATH=data/mapeador.sqlite3

# Notificações para o seu próprio WhatsApp Web (não envia mensagens a empresas)
# Número em formato internacional, apenas dígitos: Brasil + DDD + número
WHATSAPP_SELF_NUMBER=55DDDNUMERO
WHATSAPP_NOTIFICATIONS=true
# Perfil persistente do navegador usado para manter o login do WhatsApp Web
WHATSAPP_PROFILE_DIR=data/whatsapp_profile
